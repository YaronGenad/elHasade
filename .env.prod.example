# ── Al-Hasade Production Environment Template ─────────────────────────────────
# Copy this file to .env.prod and fill in ALL values before deploying.
# Never commit .env.prod with real secrets.
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_RANDOM_256_BIT_HEX

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (Aurora Serverless) ──────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@AURORA_ENDPOINT:5432/DBNAME
# Connection pooling: min=2, max=10 (Aurora cold-start requires small pool)
AURORA_CONNECTION_STRING=postgresql://alhasade:REPLACE_PASSWORD@AURORA_CLUSTER_ENDPOINT:5432/alhasade

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Gemini (primary + 3 backup keys for round-robin load distribution)
# Generate at: https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY_PRIMARY
GEMINI_API_KEY_BECKUP=REPLACE_WITH_GEMINI_API_KEY_2
GEMINI_API_KEY_BECKUP2=REPLACE_WITH_GEMINI_API_KEY_3
GEMINI_API_KEY_BECKUP3=REPLACE_WITH_GEMINI_API_KEY_4

# OpenAI fallback (used if all Gemini keys are exhausted)
# Generate at: https://platform.openai.com/api-keys
GPT_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# Anthropic fallback (last resort — used if OpenAI also fails)
# Generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# Pexels (free image search — optional but recommended)
# Register at: https://www.pexels.com/api/
PEXELS_API_KEY=REPLACE_WITH_PEXELS_API_KEY

# ── File Storage ──────────────────────────────────────────────────────────────
OUTPUT_DIR=/app/output
MAX_FILE_AGE_HOURS=24

# ── Search ────────────────────────────────────────────────────────────────────
# Calibrate after 200+ teacher queries; start with 0.3
VECTOR_SIMILARITY_THRESHOLD=0.3

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Grafana admin password — used in docker-compose.monitoring.yml
GRAFANA_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=
