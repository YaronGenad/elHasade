# Virtual environment
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Output directories
output/
__pycache__/
*.py[cod]
*$py.class

# Environment variables — real secrets are never committed
.env
.env.prod
.env.local
# .env.example and .env.prod.example are committed (they are templates with no real secrets)

# IDE
.vscode/
.idea/
*.swp
*~

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# SQLite databases (runtime artifacts)
*.db
*.sqlite
*.sqlite3

# Generated PDF artifacts
*.pdf

# Image cache (runtime downloads)
cache/

# Source image assets used during development
GoldFleece-*.jpg

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Generated materials (large runtime output)
generated_materials/

# Development planning documents (internal, not part of the codebase)
plans/

# Markdown docs — README, ARCHITECTURE, DEPLOYMENT are tracked; rest are dev process
*.md
!README.md
!ARCHITECTURE.md
!DEPLOYMENT.md
!summeryTillNow.md

# Certbot / SSL (populated on first deploy)
certbot/

# Local backups
backups/

# SSH keys / PEM files — never commit
*.pem
*.key